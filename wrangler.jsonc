{
  "$schema": "./api/node_modules/wrangler/config-schema.json",
  "name": "linguistic-research-forro-vivo",
  "main": "api/src/index.ts",
  "compatibility_date": "2026-08-20",
  "account_id": "b60a676c850b0df5874e4121d911a3c1",
  "workers_dev": false,
  "build": {
    "command": "npm ci --prefix api"
  },
  "routes": [
    { "pattern": "api.forrovivo.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "API_KEYS",
      "id": "dca0489e37514a7192f9e31c9b3251d7"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forrovivo-learner-progress",
      "database_id": "1e266c7d-7361-4507-b1a4-aa6a04612ad0",
      "migrations_dir": "api/migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "vars": {
    "API_HOST": "api.forrovivo.com",
    "API_ORIGIN": "https://api.forrovivo.com",
    "SITE_ORIGIN": "https://www.forrovivo.com",
    "GITHUB_URL": "https://github.com/Forrovivo/linguistic-research",
    "GITHUB_OWNER": "Forrovivo",
    "GITHUB_REPO": "linguistic-research",
    "GITHUB_REF": "main",
    "GITHUB_DATA_ORIGIN": "https://raw.githubusercontent.com/Forrovivo/linguistic-research/main",
    "DATASETS_GITHUB_OWNER": "Forrovivo",
    "DATASETS_GITHUB_REPO": "datasets",
    "DATASETS_GITHUB_REF": "main",
    "DATASETS_GITHUB_DATA_ORIGIN": "https://raw.githubusercontent.com/Forrovivo/datasets/main",
    "APP_STORE_URL": "https://apps.apple.com/app/id6751409176",
    "GITHUB_CACHE_TTL": "300"
  }
}
