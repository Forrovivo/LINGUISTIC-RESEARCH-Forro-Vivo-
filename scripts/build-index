#!/usr/bin/env python3
"""Rebuild parent index JSON from isolated data/ folders.

Does not merge lexicons. Writes only id/path pointers.
"""

from __future__ import annotations

import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DATA = ROOT / "data"


def write_json(path: Path, document: dict) -> None:
    path.write_text(json.dumps(document, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def main() -> None:
    saotome = json.loads((DATA / "saotome_dataset" / "dictionary.json").read_text(encoding="utf-8"))
    saotome["languages"] = [
        {"id": "forro", "island": "São Tomé", "path": "data/saotome_dataset/forro/"},
        {"id": "angolar", "island": "São Tomé", "path": "data/saotome_dataset/angolar/"},
        {"id": "lungie", "island": "Príncipe", "path": "data/saotome_dataset/lungie/"},
    ]
    saotome["entries"] = []
    saotome["entry_count"] = 0
    write_json(DATA / "saotome_dataset" / "dictionary.json", saotome)

    caboverde = json.loads((DATA / "caboverde_dataset" / "dictionary.json").read_text(encoding="utf-8"))
    for variety in caboverde.get("varieties") or []:
        variety["path"] = f"data/caboverde_dataset/{variety['id']}/"
    caboverde["entries"] = []
    caboverde["entry_count"] = 0
    write_json(DATA / "caboverde_dataset" / "dictionary.json", caboverde)

    guinebissau = json.loads((DATA / "guinebissau_dataset" / "dictionary.json").read_text(encoding="utf-8"))
    for variety in guinebissau.get("varieties") or []:
        variety["path"] = f"data/guinebissau_dataset/{variety['id']}/"
    guinebissau["entries"] = []
    guinebissau["entry_count"] = 0
    write_json(DATA / "guinebissau_dataset" / "dictionary.json", guinebissau)

    angola = json.loads((DATA / "angola_dataset" / "dictionary.json").read_text(encoding="utf-8"))
    angola.pop("alias_of", None)
    angola.pop("canonical_path", None)
    angola["language"] = "angola"
    angola["language_name"] = "Angola Contruy"
    angola["kind"] = "lexicon"
    angola["entries"] = []
    angola["entry_count"] = 0
    write_json(DATA / "angola_dataset" / "dictionary.json", angola)

    print("Rebuilt saotome_dataset, caboverde_dataset, guinebissau_dataset, and angola_dataset indexes")


if __name__ == "__main__":
    main()
