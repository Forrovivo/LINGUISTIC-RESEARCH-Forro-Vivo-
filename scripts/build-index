#!/usr/bin/env python3
"""Rebuild parent index JSON from isolated data/ folders.

Does not merge lexicons. Writes only id/path pointers.
"""

from __future__ import annotations

import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DATA = ROOT / "data"


def write_json(path: Path, document: dict) -> None:
    path.write_text(json.dumps(document, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def rewrite_child_paths(document: dict, folder_name: str) -> None:
    for key in ("languages", "varieties"):
        for child in document.get(key) or []:
            child["path"] = f"data/{folder_name}/{child['id']}/"
    document["entries"] = []
    document["entry_count"] = 0


def main() -> None:
    saotome = json.loads((DATA / "saotome_dataset" / "dictionary.json").read_text(encoding="utf-8"))
    saotome["languages"] = [
        {"id": "forro", "island": "São Tomé", "path": "data/saotome_dataset/forro/"},
        {"id": "angolar", "island": "São Tomé", "path": "data/saotome_dataset/angolar/"},
        {"id": "lungie", "island": "Príncipe", "path": "data/saotome_dataset/lungie/"},
    ]
    saotome["entries"] = []
    saotome["entry_count"] = 0
    write_json(DATA / "saotome_dataset" / "dictionary.json", saotome)

    special = {"saotome_dataset"}
    rebuilt = ["saotome_dataset"]
    for index_path in sorted(DATA.glob("*_dataset/dictionary.json")):
        folder_name = index_path.parent.name
        if folder_name in special:
            continue
        document = json.loads(index_path.read_text(encoding="utf-8"))
        if folder_name == "angola_dataset":
            document.pop("alias_of", None)
            document.pop("canonical_path", None)
            document["language"] = "angola"
            document["language_name"] = "Angola"
            document["kind"] = "language_index"
        rewrite_child_paths(document, folder_name)
        write_json(index_path, document)
        rebuilt.append(folder_name)

    print("Rebuilt indexes: " + ", ".join(rebuilt))


if __name__ == "__main__":
    main()
