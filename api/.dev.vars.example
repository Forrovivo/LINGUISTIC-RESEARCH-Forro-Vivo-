# Optional. Public GitHub data works without a token.
# Higher rate limits if GitHub starts throttling raw file reads.
GITHUB_TOKEN=

# Required to enable POST /v1/keys (must match Open Knowledge KEYS_ISSUE_SECRET).
# Generate a long random string. Set the same value as a Worker secret:
#   npx wrangler secret put KEYS_ISSUE_SECRET
KEYS_ISSUE_SECRET=
